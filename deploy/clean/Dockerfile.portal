ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_COMMIT
LABEL org.opencontainers.image.revision=${SOURCE_COMMIT} \
      org.opencontainers.image.source="https://github.com/code-nailao/sub2api-nailao" \
      org.opencontainers.image.licenses="LGPL-3.0" \
      org.opencontainers.image.description="Sub2API Portal (fork of Wei-Shaw/sub2api)" \
      maintainer="code-nailao <github.com/code-nailao>"
COPY --chmod=0755 sources-portal /app/sources-portal
COPY homeweb/ /app/homeweb/
ENTRYPOINT ["/app/sources-portal"]
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:18090/health || exit 1
