[Unit]
Description=Sources Main resident health, memory and load sampler (current release from deploy state)
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/sources-deploy/bin/deploy.py --config /opt/sources-deploy/main.json watch
Restart=always
RestartSec=5
MemoryMax=128M
CPUQuota=5%
Nice=15
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sources-main-watch

[Install]
WantedBy=multi-user.target
